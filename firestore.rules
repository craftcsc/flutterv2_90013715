rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catálogo de productos: Lectura y escritura abierta para desarrollo y demo
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Perfil de usuarios y subcolección de transacciones (users/{userId}/transactions/{txId})
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // 3. Ventas globales en tiempo real para el Administrador y registro de compras
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Regla de respaldo para cualquier otro documento
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
